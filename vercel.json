{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/blog/index.html", "destination": "/blog/", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    {
      "source": "/blog/atencion-24-7-agendamiento-automatico-pyme",
      "destination": "/blog/automatizacion-atencion-cliente-24-7-roi-real",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "automatizaweb.cl" }],
      "destination": "https://www.automatizaweb.cl/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/output.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/og.jpg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
